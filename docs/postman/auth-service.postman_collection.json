  "item": [
    {
      "name": "01 - Authentication",
      "description": "Authentication endpoints: login, register, token refresh, logout, password recovery flow.",
      "item": [
        {
          "name": "1.1 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Login successful with valid tokens and roles\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.refreshToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(jsonData.data.user.roles).to.include(\"ROLE_ADMIN\");",
                  "",
                  "    // Save tokens and Admin ID",
                  "    pm.collectionVariables.set(\"adminAccessToken\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"adminAccessToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"adminRefreshToken\", jsonData.data.refreshToken);",
                  "    pm.environment.set(\"adminRefreshToken\", jsonData.data.refreshToken);",
                  "    if (jsonData.data.user && jsonData.data.user.id) {",
                  "        pm.collectionVariables.set(\"adminUserId\", jsonData.data.user.id);",
                  "        pm.environment.set(\"adminUserId\", jsonData.data.user.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates the default administrator and stores the JWT access token and refresh token into collection and environment variables."
          },
          "response": []
        },
        {
          "name": "1.2 Register New User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique timestamped email for deterministic idempotent test runs",
                  "const timestamp = new Date().getTime();",
                  "const generatedEmail = `user_${timestamp}@example.com`;",
                  "pm.collectionVariables.set(\"userEmail\", generatedEmail);",
                  "pm.environment.set(\"userEmail\", generatedEmail);",
                  "pm.collectionVariables.set(\"userPassword\", \"Password@123\");",
                  "pm.environment.set(\"userPassword\", \"Password@123\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"User registered successfully with tokens and profile\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.refreshToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.user.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
                  "",
                  "    // Save new user credentials and IDs",
                  "    pm.collectionVariables.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"userRefreshToken\", jsonData.data.refreshToken);",
                  "    pm.environment.set(\"userRefreshToken\", jsonData.data.refreshToken);",
                  "    if (jsonData.data.user && jsonData.data.user.id) {",
                  "        pm.collectionVariables.set(\"testUserId\", jsonData.data.user.id);",
                  "        pm.environment.set(\"testUserId\", jsonData.data.user.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+447123456789\",\n  \"address\": {\n    \"addressLine1\": \"10 Downing Street\",\n    \"addressLine2\": \"Westminster\",\n    \"city\": \"London\",\n    \"county\": \"Greater London\",\n    \"postcode\": \"SW1A 2AA\",\n    \"country\": \"United Kingdom\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registers a new user with full UK address details. Geolocation coordinates (latitude/longitude) are automatically resolved by calling address-service."
          },
          "response": []
        },
        {
          "name": "1.3 User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"User login returned valid JWT token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
                  "",
                  "    // Update user access token and refresh token",
                  "    pm.collectionVariables.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"userRefreshToken\", jsonData.data.refreshToken);",
                  "    pm.environment.set(\"userRefreshToken\", jsonData.data.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates the registered user and refreshes `userAccessToken`."
          },
          "response": []
        },
        {
          "name": "1.4 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Successfully obtained new access token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
                  "",
                  "    // Store the newly issued access token",
                  "    pm.collectionVariables.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "    pm.environment.set(\"userAccessToken\", jsonData.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "description": "Obtains a fresh JWT access token without requiring re-entering email and password."
          },
          "response": []
        },
        {
          "name": "1.5 Forgot Password (Request Reset Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Password reset token issued\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.a(\"string\");",
                  "",
                  "    // Save token for next step in reset flow",
                  "    pm.collectionVariables.set(\"resetToken\", jsonData.data);",
                  "    pm.environment.set(\"resetToken\", jsonData.data);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Requests a password reset token for the given user email address. In dev mode, the token is returned in the response payload for testing."
          },
          "response": []
        },
        {
          "name": "1.6 Reset Password (Submit New Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Password reset successfully confirmed\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include(\"Password has been reset successfully\");",
                  "",
                  "    // Update user password",
                  "    pm.collectionVariables.set(\"userPassword\", \"NewPassword@123\");",
                  "    pm.environment.set(\"userPassword\", \"NewPassword@123\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Submits the password reset token along with the new password to update user credentials."
          },
          "response": []
        },
        {
          "name": "1.7 User Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Logout successful message\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the refresh token from the database, preventing any future token refresh operations with that token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Current User Profile",
      "description": "Authenticated user profile management endpoints (`/api/v1/users/me`).",
      "item": [
        {
          "name": "2.1 Get Current User Profile (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Profile data matches authenticated user\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.id).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.email).to.eql(pm.collectionVariables.get(\"userEmail\"));",
                  "    pm.expect(jsonData.data.address).to.not.be.null;",
                  "    pm.expect(jsonData.data.roles).to.include(\"ROLE_USER\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Retrieves the detailed profile information for the currently authenticated user."
          },
          "response": []
        },
        {
          "name": "2.2 Update Current User Profile (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Profile fields updated successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.firstName).to.eql(\"Johnathan\");",
                  "    pm.expect(jsonData.data.lastName).to.eql(\"Doeman\");",
                  "    pm.expect(jsonData.data.phoneNumber).to.eql(\"+447999888777\");",
                  "    pm.expect(jsonData.data.address.postcode).to.eql(\"NW1 6XE\");",
                  "    pm.expect(jsonData.data.address.city).to.eql(\"London\");",
                  "    pm.expect(jsonData.data.address.latitude).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Johnathan\",\n  \"lastName\": \"Doeman\",\n  \"phoneNumber\": \"+447999888777\",\n  \"address\": {\n    \"addressLine1\": \"221B Baker Street\",\n    \"addressLine2\": \"Marylebone\",\n    \"city\": \"London\",\n    \"county\": \"Greater London\",\n    \"postcode\": \"NW1 6XE\",\n    \"country\": \"United Kingdom\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Updates profile information and address. Geocoding coordinates are updated via address-service."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - User Administration (Admin Only)",
      "description": "Administrative endpoints requiring `ROLE_ADMIN` role.",
      "item": [
        {
          "name": "3.1 Get All Users (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns paginated user list\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
                  "    const total = jsonData.data.page ? jsonData.data.page.totalElements : jsonData.data.totalElements;",
                  "    pm.expect(total).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=10&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            },
            "description": "Fetches a paginated, sorted list of all system users. Requires `ROLE_ADMIN`."
          },
          "response": []
        },
        {
          "name": "3.2 Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"User retrieved matches testUserId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get(\"testUserId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{testUserId}}"]
            },
            "description": "Retrieves detailed user profile for a specific user ID. Requires `ROLE_ADMIN`."
          },
          "response": []
        },
        {
          "name": "3.3 Setup Temporary User for Role Update & Deletion",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = new Date().getTime();",
                  "const tempEmail = `temp_admin_test_${ts}@example.com`;",
                  "pm.collectionVariables.set(\"tempUserEmail\", tempEmail);",
                  "pm.environment.set(\"tempUserEmail\", tempEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Temp user created for role modification and deletion test\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.collectionVariables.set(\"tempUserId\", jsonData.data.user.id);",
                  "    pm.environment.set(\"tempUserId\", jsonData.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tempUserEmail}}\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Temp\",\n  \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Creates a dedicated temporary user specifically for role updates and deletion tests to isolate test side effects."
          },
          "response": []
